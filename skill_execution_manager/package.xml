<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>skill_execution_manager</name>
  <version>0.0.0</version>
  <description>Execution manager for robust skill plans: observes state, classifies partition, runs nominal or enablement path, escalates on failure.</description>
  <maintainer email="anonymous@example.com">anonymous</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <depend>rclpy</depend>
  <depend>quadruped_example_skillset_interfaces</depend>
  <depend>quadruped_example_skillset_client</depend>
  <depend>ament_index_python</depend>
  <depend>test_campaign_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
